import { useState } from "react";

import {
  useMutation,
  useQuery,
  useQueryClient,
} from "@tanstack/react-query";

import {
  getProducts,
  createProduct,
  updateProduct,
  deleteProduct,
  increaseProductStock,
  uploadProductImage,
  bulkImportProducts,
} from "../../services/productService";
import TaskProgressModal from "../../components/TaskProgressModal";


function AdminProducts() {
  // ==========================================================
  // TANSTACK QUERY
  // ==========================================================

  const queryClient = useQueryClient();

  const {
    data: products = [],
    isLoading: loading,
    error: productsError,
  } = useQuery({
    queryKey: ["admin", "products"],
    queryFn: getProducts,
  });


  // ==========================================================
  // MUTATIONS
  // ==========================================================

  // ADD PRODUCT
  const createProductMutation = useMutation({
    mutationFn: async ({
      productData,
      image,
    }) => {
      const newProduct =
        await createProduct(productData);

      if (image) {
        await uploadProductImage(
          newProduct.id,
          image
        );
      }

      return newProduct;
    },

    onSuccess: () => {
      queryClient.invalidateQueries({
        queryKey: ["admin", "products"],
      });
    },
  });


  // UPDATE PRODUCT
  const updateProductMutation =
    useMutation({
      mutationFn: ({
        productId,
        productData,
      }) =>
        updateProduct(
          productId,
          productData
        ),

      onSuccess: () => {
        queryClient.invalidateQueries({
          queryKey: ["admin", "products"],
        });
      },
    });


  // DELETE PRODUCT
  const deleteProductMutation =
    useMutation({
      mutationFn: (productId) =>
        deleteProduct(productId),

      onSuccess: () => {
        queryClient.invalidateQueries({
          queryKey: ["admin", "products"],
        });
      },
    });


  // INCREASE STOCK
  const increaseStockMutation =
    useMutation({
      mutationFn: ({
        productId,
        quantity,
      }) =>
        increaseProductStock(
          productId,
          quantity
        ),

      onSuccess: () => {
        queryClient.invalidateQueries({
          queryKey: ["admin", "products"],
        });
      },
    });


  // UPDATE IMAGE
  const updateImageMutation =
    useMutation({
      mutationFn: ({
        productId,
        image,
      }) =>
        uploadProductImage(
          productId,
          image
        ),

      onSuccess: () => {
        queryClient.invalidateQueries({
          queryKey: ["admin", "products"],
        });
      },
    });


  // ==========================================================
  // UI / FORM STATE
  // ==========================================================

  const [selectedCategory, setSelectedCategory] =
    useState("All");

  const [error, setError] =
    useState("");

  const [success, setSuccess] =
    useState("");


  // ==========================================================
  // ADD PRODUCT
  // ==========================================================

  const [showAddForm, setShowAddForm] =
    useState(false);

  const [productName, setProductName] =
    useState("");

  const [productCategory, setProductCategory] =
    useState("Electronics");

  const [productDescription, setProductDescription] =
    useState("");

  const [productPrice, setProductPrice] =
    useState("");

  const [productStock, setProductStock] =
    useState("");

  const [selectedImage, setSelectedImage] =
    useState(null);

  const [imagePreview, setImagePreview] =
    useState("");

  const [saving, setSaving] =
    useState(false);


  // ==========================================================
  // BULK CSV IMPORT (CELERY TASK)
  // ==========================================================

  const [showCsvModal, setShowCsvModal] =
    useState(false);

  const [csvFile, setCsvFile] =
    useState(null);

  const [csvTask, setCsvTask] =
    useState(null);

  const [importingCsv, setImportingCsv] =
    useState(false);


  // ==========================================================
  // EDIT PRODUCT
  // ==========================================================

  const [editingProduct, setEditingProduct] =
    useState(null);

  const [editName, setEditName] =
    useState("");

  const [editCategory, setEditCategory] =
    useState("Electronics");

  const [editDescription, setEditDescription] =
    useState("");

  const [editPrice, setEditPrice] =
    useState("");

  const [editStock, setEditStock] =
    useState("");

  const [updating, setUpdating] =
    useState(false);


  // ==========================================================
  // INCREASE STOCK
  // ==========================================================

  const [stockProduct, setStockProduct] =
    useState(null);

  const [stockQuantity, setStockQuantity] =
    useState("");

  const [increasingStock, setIncreasingStock] =
    useState(false);


  // ==========================================================
  // IMAGE UPDATE
  // ==========================================================

  const [imageProduct, setImageProduct] =
    useState(null);

  const [imageFile, setImageFile] =
    useState(null);

  const [imageUpdatePreview, setImageUpdatePreview] =
    useState("");

  const [updatingImage, setUpdatingImage] =
    useState(false);


  // ==========================================================
  // CATEGORIES
  // ==========================================================

  const categories = [
    "All",
    "Mobiles",
    "Electronics",
    "Fashion",
    "Home & Kitchen",
    "Gaming",
  ];

  const productFormCategories = [
    "Mobiles",
    "Electronics",
    "Fashion",
    "Home & Kitchen",
    "Gaming",
  ];


  // ==========================================================
  // PRODUCT QUERY ERROR
  // ==========================================================

  const queryErrorMessage =
    productsError?.response?.data?.detail ||
    "Unable to load products.";


  // ==========================================================
  // ADD PRODUCT IMAGE
  // ==========================================================

  const handleImageChange = (event) => {
    const file =
      event.target.files?.[0];

    if (!file) {
      return;
    }

    if (
      !file.type.startsWith("image/")
    ) {
      setError(
        "Please select a valid image file."
      );

      return;
    }

    if (
      file.size > 5 * 1024 * 1024
    ) {
      setError(
        "Image size must be less than 5 MB."
      );

      return;
    }

    setError("");

    setSelectedImage(file);

    const previewUrl =
      URL.createObjectURL(file);

    setImagePreview(previewUrl);
  };


  // ==========================================================
  // ADD PRODUCT
  // ==========================================================

  const handleAddProduct = async (
    event
  ) => {
    event.preventDefault();

    setError("");
    setSuccess("");

    if (!productName.trim()) {
      setError(
        "Please enter the product name."
      );

      return;
    }

    if (
      !productPrice ||
      Number(productPrice) <= 0
    ) {
      setError(
        "Please enter a valid price."
      );

      return;
    }

    if (
      productStock === "" ||
      Number(productStock) < 0
    ) {
      setError(
        "Please enter a valid stock quantity."
      );

      return;
    }

    try {
      setSaving(true);

      const productData = {
        name: productName.trim(),
        category: productCategory,
        description:
          productDescription.trim() ||
          null,
        price: Number(productPrice),
        stock: Number(productStock),
      };

      await createProductMutation.mutateAsync({
        productData,
        image: selectedImage,
      });

      setSuccess(
        "Product added successfully."
      );

      resetAddForm();

    } catch (err) {
      console.error(
        "CREATE PRODUCT ERROR:",
        err
      );

      setError(
        err?.response?.data?.detail ||
          "Unable to create product."
      );

    } finally {
      setSaving(false);
    }
  };


  // ==========================================================
  // RESET ADD FORM
  // ==========================================================

  const resetAddForm = () => {
    setShowAddForm(false);

    setProductName("");

    setProductCategory(
      "Electronics"
    );

    setProductDescription("");

    setProductPrice("");

    setProductStock("");

    setSelectedImage(null);

    setImagePreview("");
  };


  // ==========================================================
  // BULK IMPORT CSV HANDLER (CELERY TASK)
  // ==========================================================

  const handleBulkCsvImport = async (event) => {
    event.preventDefault();

    if (!csvFile) {
      setError("Please select a valid CSV file.");
      return;
    }

    try {
      setImportingCsv(true);
      setError("");
      setSuccess("");

      const response = await bulkImportProducts(csvFile);

      setCsvTask({
        taskId: response.task_id,
        filename: response.filename || csvFile.name,
      });

      setShowCsvModal(false);
      setCsvFile(null);
    } catch (err) {
      console.error("BULK CSV IMPORT ERROR:", err);
      setError(
        err?.response?.data?.detail || "Unable to start bulk CSV import."
      );
    } finally {
      setImportingCsv(false);
    }
  };


  // ==========================================================
  // OPEN EDIT FORM
  // ==========================================================

  const handleEditProduct = (
    product
  ) => {
    setEditingProduct(product);

    setEditName(
      product.name || ""
    );

    setEditCategory(
      product.category ||
        "Electronics"
    );

    setEditDescription(
      product.description || ""
    );

    setEditPrice(
      product.price ?? ""
    );

    setEditStock(
      product.stock ?? ""
    );

    setError("");

    setSuccess("");
  };


  // ==========================================================
  // SAVE EDIT
  // ==========================================================

  const handleUpdateProduct = async (
    event
  ) => {
    event.preventDefault();

    if (!editingProduct) {
      return;
    }

    setError("");
    setSuccess("");

    if (!editName.trim()) {
      setError(
        "Please enter the product name."
      );

      return;
    }

    if (
      !editPrice ||
      Number(editPrice) <= 0
    ) {
      setError(
        "Please enter a valid price."
      );

      return;
    }

    if (
      editStock === "" ||
      Number(editStock) < 0
    ) {
      setError(
        "Please enter a valid stock."
      );

      return;
    }

    try {
      setUpdating(true);

      const productData = {
        name: editName.trim(),

        category: editCategory,

        description:
          editDescription.trim() ||
          null,

        price: Number(editPrice),

        stock: Number(editStock),
      };

      const updatedProduct =
        await updateProductMutation.mutateAsync({
          productId: editingProduct.id,
          productData,
        });

      setSuccess(
        `Product "${updatedProduct.name}" updated successfully.`
      );

      setEditingProduct(null);

    } catch (err) {
      console.error(
        "UPDATE PRODUCT ERROR:",
        err
      );

      setError(
        err?.response?.data?.detail ||
          "Unable to update product."
      );

    } finally {
      setUpdating(false);
    }
  };


  // ==========================================================
  // CANCEL EDIT
  // ==========================================================

  const handleCancelEdit = () => {
    setEditingProduct(null);

    setEditName("");

    setEditCategory(
      "Electronics"
    );

    setEditDescription("");

    setEditPrice("");

    setEditStock("");

    setError("");
  };


  // ==========================================================
  // DELETE PRODUCT
  // ==========================================================

  const handleDeleteProduct = async (
    product
  ) => {
    const confirmed =
      window.confirm(
        `Are you sure you want to delete "${product.name}"?`
      );

    if (!confirmed) {
      return;
    }

    try {
      setError("");
      setSuccess("");

      await deleteProductMutation.mutateAsync(
        product.id
      );

      setSuccess(
        `Product "${product.name}" deleted successfully.`
      );

    } catch (err) {
      console.error(
        "DELETE PRODUCT ERROR:",
        err
      );

      setError(
        err?.response?.data?.detail ||
          "Unable to delete product."
      );
    }
  };


  // ==========================================================
  // OPEN STOCK FORM
  // ==========================================================

  const handleOpenStock = (
    product
  ) => {
    setStockProduct(product);

    setStockQuantity("");

    setError("");

    setSuccess("");
  };


  // ==========================================================
  // INCREASE STOCK
  // ==========================================================

  const handleIncreaseStock = async (
    event
  ) => {
    event.preventDefault();

    if (!stockProduct) {
      return;
    }

    const quantity =
      Number(stockQuantity);

    if (
      !stockQuantity ||
      quantity <= 0
    ) {
      setError(
        "Enter a quantity greater than 0."
      );

      return;
    }

    try {
      setIncreasingStock(true);

      const updatedProduct =
        await increaseStockMutation.mutateAsync({
          productId: stockProduct.id,
          quantity,
        });

      setSuccess(
        `Stock increased successfully. New stock: ${updatedProduct.stock}`
      );

      setStockProduct(null);

      setStockQuantity("");

    } catch (err) {
      console.error(
        "INCREASE STOCK ERROR:",
        err
      );

      setError(
        err?.response?.data?.detail ||
          "Unable to increase stock."
      );

    } finally {
      setIncreasingStock(false);
    }
  };


  // ==========================================================
  // OPEN IMAGE UPDATE
  // ==========================================================

  const handleOpenImageUpdate = (
    product
  ) => {
    setImageProduct(product);

    setImageFile(null);

    setImageUpdatePreview("");

    setError("");

    setSuccess("");
  };


  // ==========================================================
  // SELECT NEW PRODUCT IMAGE
  // ==========================================================

  const handleUpdateImageChange = (
    event
  ) => {
    const file =
      event.target.files?.[0];

    if (!file) {
      return;
    }

    if (
      !file.type.startsWith("image/")
    ) {
      setError(
        "Please select a valid image file."
      );

      return;
    }

    if (
      file.size > 5 * 1024 * 1024
    ) {
      setError(
        "Image size must be less than 5 MB."
      );

      return;
    }

    setError("");

    setImageFile(file);

    setImageUpdatePreview(
      URL.createObjectURL(file)
    );
  };


  // ==========================================================
  // UPLOAD NEW IMAGE
  // ==========================================================

  const handleUpdateImage = async (
    event
  ) => {
    event.preventDefault();

    if (
      !imageProduct ||
      !imageFile
    ) {
      setError(
        "Please select an image."
      );

      return;
    }

    try {
      setUpdatingImage(true);

      const updatedProduct =
        await updateImageMutation.mutateAsync({
          productId: imageProduct.id,
          image: imageFile,
        });

      setSuccess(
        `Image for "${updatedProduct.name}" updated successfully.`
      );

      setImageProduct(null);

      setImageFile(null);

      setImageUpdatePreview("");

    } catch (err) {
      console.error(
        "IMAGE UPDATE ERROR:",
        err
      );

      setError(
        err?.response?.data?.detail ||
          "Unable to update product image."
      );

    } finally {
      setUpdatingImage(false);
    }
  };


  // ==========================================================
  // FILTER
  // ==========================================================

  const filteredProducts =
    selectedCategory === "All"
      ? products
      : products.filter(
          (product) =>
            product.category ===
            selectedCategory
        );


  // ==========================================================
  // SUMMARY
  // ==========================================================

  const totalProducts =
    products.length;

  const activeProducts =
    products.filter(
      (product) =>
        product.stock > 0
    ).length;

  const lowStockProducts =
    products.filter(
      (product) =>
        product.stock > 0 &&
        product.stock <= 10
    ).length;

  const outOfStockProducts =
    products.filter(
      (product) =>
        product.stock === 0
    ).length;


  // ==========================================================
  // STATUS
  // ==========================================================

  const getStatus = (
    stock
  ) => {
    if (stock === 0) {
      return "Out of Stock";
    }

    if (stock <= 10) {
      return "Low Stock";
    }

    return "Available";
  };


  const getStatusClass = (
    stock
  ) => {
    if (stock === 0) {
      return "status-danger";
    }

    if (stock <= 10) {
      return "status-warning";
    }

    return "status-success";
  };


  // ==========================================================
  // RENDER
  // ==========================================================

  return (
    <div className="admin-content">

      {/* ================================================== */}
      {/* HEADER */}
      {/* ================================================== */}

      <div
        style={{
          display: "flex",
          justifyContent:
            "space-between",
          alignItems: "center",
          gap: "20px",
          flexWrap: "wrap",
          marginBottom: "20px",
        }}
      >
        <div>
          <h1>Products</h1>

          <p>
            Manage products,
            categories, prices,
            stock and images.
          </p>
        </div>

        <button
          type="button"
          onClick={() => {
            setShowAddForm(true);

            setError("");

            setSuccess("");
          }}
          style={{
            padding:
              "11px 18px",
            border: "none",
            borderRadius:
              "7px",
            background:
              "#2563eb",
            color: "#fff",
            fontWeight:
              "600",
            cursor:
              "pointer",
          }}
        >
          + Add Product
        </button>
      </div>


      {/* ================================================== */}
      {/* SUCCESS */}
      {/* ================================================== */}

      {success && (
        <div
          style={{
            margin:
              "20px 0",
            padding:
              "12px 15px",
            borderRadius:
              "6px",
            background:
              "#dcfce7",
            color:
              "#166534",
            border:
              "1px solid #bbf7d0",
          }}
        >
          ✓ {success}
        </div>
      )}


      {/* ================================================== */}
      {/* ERROR */}
      {/* ================================================== */}

      {error && (
        <div
          style={{
            margin:
              "20px 0",
            padding:
              "12px 15px",
            borderRadius:
              "6px",
            background:
              "#fee2e2",
            color:
              "#991b1b",
            border:
              "1px solid #fecaca",
          }}
        >
          {error}
        </div>
      )}


      {/* ================================================== */}
      {/* QUERY ERROR */}
      {/* ================================================== */}

      {productsError && !error && (
        <div
          style={{
            margin:
              "20px 0",
            padding:
              "12px 15px",
            borderRadius:
              "6px",
            background:
              "#fee2e2",
            color:
              "#991b1b",
            border:
              "1px solid #fecaca",
          }}
        >
          {queryErrorMessage}
        </div>
      )}


      {/* ================================================== */}
      {/* EDIT PRODUCT */}
      {/* ================================================== */}

      {editingProduct && (
        <div
          style={{
            marginBottom:
              "30px",
            padding:
              "25px",
            background:
              "#fff",
            border:
              "1px solid #e5e7eb",
            borderRadius:
              "10px",
            boxShadow:
              "0 2px 8px rgba(0,0,0,0.06)",
          }}
        >
          <h2>
            Edit Product
          </h2>

          <p>
            Product ID:{" "}
            {editingProduct.id}
          </p>

          <form
            onSubmit={
              handleUpdateProduct
            }
          >

            <div
              style={{
                marginBottom:
                  "18px",
              }}
            >
              <label>
                Product Name
              </label>

              <input
                type="text"
                value={editName}
                onChange={(event) =>
                  setEditName(
                    event.target.value
                  )
                }
                style={{
                  width:
                    "100%",
                  padding:
                    "11px",
                  marginTop:
                    "7px",
                  boxSizing:
                    "border-box",
                }}
              />
            </div>


            <div
              style={{
                marginBottom:
                  "18px",
              }}
            >
              <label>
                Category
              </label>

              <select
                value={
                  editCategory
                }
                onChange={(event) =>
                  setEditCategory(
                    event.target.value
                  )
                }
                style={{
                  width:
                    "100%",
                  padding:
                    "11px",
                  marginTop:
                    "7px",
                }}
              >
                {productFormCategories.map(
                  (category) => (
                    <option
                      key={
                        category
                      }
                      value={
                        category
                      }
                    >
                      {category}
                    </option>
                  )
                )}
              </select>
            </div>


            <div
              style={{
                marginBottom:
                  "18px",
              }}
            >
              <label>
                Description
              </label>

              <textarea
                rows="4"
                value={
                  editDescription
                }
                onChange={(event) =>
                  setEditDescription(
                    event.target.value
                  )
                }
                style={{
                  width:
                    "100%",
                  padding:
                    "11px",
                  marginTop:
                    "7px",
                  boxSizing:
                    "border-box",
                }}
              />
            </div>


            <div
              style={{
                display:
                  "grid",
                gridTemplateColumns:
                  "1fr 1fr",
                gap:
                  "18px",
                marginBottom:
                  "20px",
              }}
            >

              <div>
                <label>
                  Price
                </label>

                <input
                  type="number"
                  min="0"
                  step="0.01"
                  value={
                    editPrice
                  }
                  onChange={(event) =>
                    setEditPrice(
                      event.target.value
                    )
                  }
                  style={{
                    width:
                      "100%",
                    padding:
                      "11px",
                    marginTop:
                      "7px",
                    boxSizing:
                      "border-box",
                  }}
                />
              </div>


              <div>
                <label>
                  Stock
                </label>

                <input
                  type="number"
                  min="0"
                  value={
                    editStock
                  }
                  onChange={(event) =>
                    setEditStock(
                      event.target.value
                    )
                  }
                  style={{
                    width:
                      "100%",
                    padding:
                      "11px",
                    marginTop:
                      "7px",
                    boxSizing:
                      "border-box",
                  }}
                />
              </div>

            </div>


            <div
              style={{
                display:
                  "flex",
                gap:
                  "10px",
              }}
            >

              <button
                type="submit"
                disabled={
                  updating
                }
                style={{
                  padding:
                    "11px 20px",
                  border:
                    "none",
                  borderRadius:
                    "6px",
                  background:
                    "#2563eb",
                  color:
                    "#fff",
                  fontWeight:
                    "600",
                  cursor:
                    "pointer",
                }}
              >
                {updating
                  ? "Saving..."
                  : "Save Changes"}
              </button>


              <button
                type="button"
                onClick={
                  handleCancelEdit
                }
                style={{
                  padding:
                    "11px 20px",
                  border:
                    "1px solid #d1d5db",
                  borderRadius:
                    "6px",
                  background:
                    "#fff",
                  cursor:
                    "pointer",
                }}
              >
                Cancel
              </button>

            </div>

          </form>
        </div>
      )}


      {/* ================================================== */}
      {/* INCREASE STOCK */}
      {/* ================================================== */}

      {stockProduct && (
        <div
          style={{
            marginBottom:
              "30px",
            padding:
              "25px",
            background:
              "#fff",
            border:
              "1px solid #e5e7eb",
            borderRadius:
              "10px",
          }}
        >

          <h2>
            Increase Stock
          </h2>

          <p>
            <strong>
              {stockProduct.name}
            </strong>
          </p>

          <p>
            Current Stock:{" "}
            <strong>
              {stockProduct.stock}
            </strong>
          </p>


          <form
            onSubmit={
              handleIncreaseStock
            }
          >

            <input
              type="number"
              min="1"
              value={
                stockQuantity
              }
              onChange={(event) =>
                setStockQuantity(
                  event.target.value
                )
              }
              placeholder="Quantity to add"
              style={{
                width:
                  "100%",
                padding:
                  "11px",
                marginBottom:
                  "15px",
                boxSizing:
                  "border-box",
              }}
            />


            <div
              style={{
                display:
                  "flex",
                gap:
                  "10px",
              }}
            >

              <button
                type="submit"
                disabled={
                  increasingStock
                }
                style={{
                  padding:
                    "11px 20px",
                  border:
                    "none",
                  borderRadius:
                    "6px",
                  background:
                    "#16a34a",
                  color:
                    "#fff",
                  fontWeight:
                    "600",
                  cursor:
                    "pointer",
                }}
              >
                {increasingStock
                  ? "Updating..."
                  : "Increase Stock"}
              </button>


              <button
                type="button"
                onClick={() =>
                  setStockProduct(
                    null
                  )
                }
                style={{
                  padding:
                    "11px 20px",
                  border:
                    "1px solid #d1d5db",
                  borderRadius:
                    "6px",
                  background:
                    "#fff",
                  cursor:
                    "pointer",
                }}
              >
                Cancel
              </button>

            </div>

          </form>
        </div>
      )}


      {/* ================================================== */}
      {/* IMAGE UPDATE */}
      {/* ================================================== */}

      {imageProduct && (
        <div
          style={{
            marginBottom:
              "30px",
            padding:
              "25px",
            background:
              "#fff",
            border:
              "1px solid #e5e7eb",
            borderRadius:
              "10px",
          }}
        >

          <h2>
            Update Product Image
          </h2>

          <p>
            <strong>
              {imageProduct.name}
            </strong>
          </p>


          <form
            onSubmit={
              handleUpdateImage
            }
          >

            <input
              type="file"
              accept="image/*"
              onChange={
                handleUpdateImageChange
              }
              style={{
                marginBottom:
                  "15px",
              }}
            />


            {imageUpdatePreview && (
              <div
                style={{
                  marginBottom:
                    "20px",
                }}
              >
                <p>
                  New Image Preview
                </p>

                <img
                  src={
                    imageUpdatePreview
                  }
                  alt="New product preview"
                  style={{
                    width:
                      "180px",
                    height:
                      "180px",
                    objectFit:
                      "cover",
                    borderRadius:
                      "8px",
                  }}
                />
              </div>
            )}


            <div
              style={{
                display:
                  "flex",
                gap:
                  "10px",
              }}
            >

              <button
                type="submit"
                disabled={
                  updatingImage
                }
                style={{
                  padding:
                    "11px 20px",
                  border:
                    "none",
                  borderRadius:
                    "6px",
                  background:
                    "#7c3aed",
                  color:
                    "#fff",
                  fontWeight:
                    "600",
                  cursor:
                    "pointer",
                }}
              >
                {updatingImage
                  ? "Uploading..."
                  : "Update Image"}
              </button>


              <button
                type="button"
                onClick={() => {
                  setImageProduct(
                    null
                  );

                  setImageFile(
                    null
                  );

                  setImageUpdatePreview(
                    ""
                  );
                }}
                style={{
                  padding:
                    "11px 20px",
                  border:
                    "1px solid #d1d5db",
                  borderRadius:
                    "6px",
                  background:
                    "#fff",
                  cursor:
                    "pointer",
                }}
              >
                Cancel
              </button>

            </div>

          </form>
        </div>
      )}


      {/* ================================================== */}
      {/* ADD PRODUCT */}
      {/* ================================================== */}

      {showAddForm && (
        <div
          style={{
            marginBottom:
              "30px",
            padding:
              "25px",
            background:
              "#fff",
            border:
              "1px solid #e5e7eb",
            borderRadius:
              "10px",
          }}
        >

          <h2>
            Add New Product
          </h2>

          <form
            onSubmit={
              handleAddProduct
            }
          >

            <input
              type="text"
              placeholder="Product name"
              value={
                productName
              }
              onChange={(event) =>
                setProductName(
                  event.target.value
                )
              }
              style={{
                width:
                  "100%",
                padding:
                  "11px",
                marginBottom:
                  "15px",
              }}
            />


            <select
              value={
                productCategory
              }
              onChange={(event) =>
                setProductCategory(
                  event.target.value
                )
              }
              style={{
                width:
                  "100%",
                padding:
                  "11px",
                marginBottom:
                  "15px",
              }}
            >
              {productFormCategories.map(
                (category) => (
                  <option
                    key={
                      category
                    }
                    value={
                      category
                    }
                  >
                    {category}
                  </option>
                )
              )}
            </select>


            <textarea
              placeholder="Description"
              rows="4"
              value={
                productDescription
              }
              onChange={(event) =>
                setProductDescription(
                  event.target.value
                )
              }
              style={{
                width:
                  "100%",
                padding:
                  "11px",
                marginBottom:
                  "15px",
                boxSizing:
                  "border-box",
              }}
            />


            <input
              type="number"
              placeholder="Price"
              value={
                productPrice
              }
              onChange={(event) =>
                setProductPrice(
                  event.target.value
                )
              }
              style={{
                width:
                  "100%",
                padding:
                  "11px",
                marginBottom:
                  "15px",
              }}
            />


            <input
              type="number"
              placeholder="Stock"
              value={
                productStock
              }
              onChange={(event) =>
                setProductStock(
                  event.target.value
                )
              }
              style={{
                width:
                  "100%",
                padding:
                  "11px",
                marginBottom:
                  "15px",
              }}
            />


            <input
              type="file"
              accept="image/*"
              onChange={
                handleImageChange
              }
              style={{
                marginBottom:
                  "15px",
              }}
            />


            {imagePreview && (
              <img
                src={
                  imagePreview
                }
                alt="Product preview"
                style={{
                  width:
                    "150px",
                  height:
                    "150px",
                  objectFit:
                    "cover",
                  display:
                    "block",
                  marginBottom:
                    "15px",
                }}
              />
            )}


            <button
              type="submit"
              disabled={
                saving
              }
              style={{
                padding:
                  "11px 20px",
                background:
                  "#2563eb",
                color:
                  "#fff",
                border:
                  "none",
                borderRadius:
                  "6px",
                cursor:
                  "pointer",
              }}
            >
              {saving
                ? "Saving..."
                : "Add Product"}
            </button>


            <button
              type="button"
              onClick={
                resetAddForm
              }
              style={{
                marginLeft:
                  "10px",
                padding:
                  "11px 20px",
                background:
                  "#fff",
                border:
                  "1px solid #d1d5db",
                borderRadius:
                  "6px",
                cursor:
                  "pointer",
              }}
            >
              Cancel
            </button>

          </form>
        </div>
      )}


      {/* ================================================== */}
      {/* CATEGORY FILTER */}
      {/* ================================================== */}

      <div
        style={{
          display:
            "flex",
          gap:
            "10px",
          flexWrap:
            "wrap",
          marginBottom:
            "25px",
        }}
      >

        <strong>
          Category:
        </strong>

        {categories.map(
          (category) => (
            <button
              key={
                category
              }
              type="button"
              onClick={() =>
                setSelectedCategory(
                  category
                )
              }
              style={{
                padding:
                  "8px 14px",
                border:
                  "1px solid #ccc",
                borderRadius:
                  "6px",
                background:
                  selectedCategory ===
                  category
                    ? "#2563eb"
                    : "#fff",
                color:
                  selectedCategory ===
                  category
                    ? "#fff"
                    : "#000",
                cursor:
                  "pointer",
              }}
            >
              {category}
            </button>
          )
        )}

      </div>


      {/* ================================================== */}
      {/* SUMMARY */}
      {/* ================================================== */}

      <div className="dashboard-grid">

        <div className="dashboard-card">
          <h3>
            Total Products
          </h3>

          <div className="card-value">
            {totalProducts}
          </div>
        </div>


        <div className="dashboard-card">
          <h3>
            Active Products
          </h3>

          <div className="card-value">
            {activeProducts}
          </div>
        </div>


        <div className="dashboard-card">
          <h3>
            Low Stock
          </h3>

          <div className="card-value">
            {lowStockProducts}
          </div>
        </div>


        <div className="dashboard-card">
          <h3>
            Out of Stock
          </h3>

          <div className="card-value">
            {outOfStockProducts}
          </div>
        </div>

      </div>


      {/* ================================================== */}
      {/* PRODUCT TABLE */}
      {/* ================================================== */}

      <h2>
        Product List
      </h2>


      <div className="admin-table-container">

        {loading ? (
          <p>
            Loading products...
          </p>
        ) : filteredProducts.length === 0 ? (
          <p>
            No products found.
          </p>
        ) : (

          <table className="admin-table">

            <thead>

              <tr>

                <th>
                  ID
                </th>

                <th>
                  Image
                </th>

                <th>
                  Product
                </th>

                <th>
                  Category
                </th>

                <th>
                  Price
                </th>

                <th>
                  Stock
                </th>

                <th>
                  Status
                </th>

                <th>
                  Actions
                </th>

              </tr>

            </thead>


            <tbody>

              {filteredProducts.map(
                (product) => {

                  const imageUrl =
                    product.image_url
                      ? `http://127.0.0.1:8000${product.image_url}`
                      : null;

                  return (

                    <tr
                      key={
                        product.id
                      }
                    >

                      <td>
                        {product.id}
                      </td>


                      <td>

                        {imageUrl ? (

                          <img
                            src={
                              imageUrl
                            }
                            alt={
                              product.name
                            }
                            style={{
                              width:
                                "60px",
                              height:
                                "60px",
                              objectFit:
                                "cover",
                              borderRadius:
                                "6px",
                            }}
                          />

                        ) : (

                          <div>
                            No Image
                          </div>

                        )}

                      </td>


                      <td>
                        <strong>
                          {
                            product.name
                          }
                        </strong>
                      </td>


                      <td>
                        {
                          product.category
                        }
                      </td>


                      <td>
                        ₹
                        {Number(
                          product.price
                        ).toLocaleString(
                          "en-IN"
                        )}
                      </td>


                      <td>
                        {
                          product.stock
                        }
                      </td>


                      <td>

                        <span
                          className={
                            getStatusClass(
                              product.stock
                            )
                          }
                        >
                          {
                            getStatus(
                              product.stock
                            )
                          }
                        </span>

                      </td>


                      {/* ACTIONS */}

                      <td>

                        <div
                          style={{
                            display:
                              "flex",
                            gap:
                              "6px",
                            flexWrap:
                              "wrap",
                          }}
                        >

                          {/* EDIT */}

                          <button
                            type="button"
                            onClick={() =>
                              handleEditProduct(
                                product
                              )
                            }
                            style={{
                              padding:
                                "6px 10px",
                              border:
                                "none",
                              borderRadius:
                                "5px",
                              background:
                                "#2563eb",
                              color:
                                "#fff",
                              cursor:
                                "pointer",
                            }}
                          >
                            Edit
                          </button>


                          {/* STOCK */}

                          <button
                            type="button"
                            onClick={() =>
                              handleOpenStock(
                                product
                              )
                            }
                            style={{
                              padding:
                                "6px 10px",
                              border:
                                "none",
                              borderRadius:
                                "5px",
                              background:
                                "#16a34a",
                              color:
                                "#fff",
                              cursor:
                                "pointer",
                            }}
                          >
                            + Stock
                          </button>


                          {/* IMAGE */}

                          <button
                            type="button"
                            onClick={() =>
                              handleOpenImageUpdate(
                                product
                              )
                            }
                            style={{
                              padding:
                                "6px 10px",
                              border:
                                "none",
                              borderRadius:
                                "5px",
                              background:
                                "#7c3aed",
                              color:
                                "#fff",
                              cursor:
                                "pointer",
                            }}
                          >
                            Image
                          </button>


                          {/* DELETE */}

                          <button
                            type="button"
                            onClick={() =>
                              handleDeleteProduct(
                                product
                              )
                            }
                            style={{
                              padding:
                                "6px 10px",
                              border:
                                "none",
                              borderRadius:
                                "5px",
                              background:
                                "#dc2626",
                              color:
                                "#fff",
                              cursor:
                                "pointer",
                            }}
                          >
                            Delete
                          </button>

                        </div>

                      </td>

                    </tr>

                  );
                }
              )}

            </tbody>

          </table>

        )}

      </div>

    </div>
  );
}


export default AdminProducts;
